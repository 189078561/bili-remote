{
  "manifest_version": 3,
  "name": "解析助手",
  "version": "1.2.1",
  "description": "在当前 B 站标签页解析正片，并推送到自己的 Bili Remote。",
  "permissions": ["activeTab", "scripting", "storage", "declarativeNetRequestWithHostAccess"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {"default_title": "解析助手", "default_popup": "popup.html"}
}
