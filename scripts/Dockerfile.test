FROM bili-remote:1.0.0
USER root
RUN apt-get update && apt-get install -y --no-install-recommends nodejs && rm -rf /var/lib/apt/lists/*
RUN python -m pip install 'pytest>=8.3,<10' 'pytest-asyncio>=0.24,<2' 'playwright>=1.55,<2' build
RUN python -m playwright install --with-deps chromium
RUN python -m pip install 'setuptools>=68' wheel
WORKDIR /work
ENTRYPOINT []
CMD ["python", "scripts/dev_test.py", "all", "--python", "/usr/local/bin/python"]
