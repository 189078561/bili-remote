APP_NAME=Bili Remote
APP_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
SECURE_COOKIES=true
SESSION_MAX_AGE_SECONDS=43200
TZ=Asia/Shanghai
LOG_RETENTION_DAYS=30

# 多连接下载。快速档：16 连接、5MB 分片、20MB 最小分片。
ARIA2_ENABLED=true
ARIA2_CONNECTIONS=8
ARIA2_RESUME_RETRIES=2
ARIA2_MIN_SPLIT_SIZE=4M
ARIA2_PIECE_SIZE=4M

# CDN 短测速：采样越小解析越快，采样越大越能反映持续速度。
TV_CDN_PROBE=true
CDN_PROBE_TIMEOUT_SECONDS=3
CDN_PROBE_SAMPLE_BYTES=524288
CDN_PROBE_CONNECTIONS=8
LINE_COMPARE=true

# Linux 宿主机目录。首次启动前确保运行容器所用的 UID 1000 可写。
DATA_ROOT_HOST=./data
DOWNLOAD_ROOT_HOST=/srv/bilibili-downloads

# 旧资源工作台使用的导入、暂存和发布目录。宿主机目录需对容器 UID 1000 可写。
IMPORTS_ROOT_HOST=./imports
STAGING_ROOT_HOST=./staging
RELEASES_ROOT_HOST=./releases

# 文件浏览器的四类目录。下载目录沿用 DOWNLOAD_ROOT_HOST，不会改变下载行为。
TORRENTS_ROOT_HOST=./torrents
IMAGES_ROOT_HOST=./images
RELEASE_INFO_ROOT_HOST=./release-info

# PT-Gen 随 Compose 启动。默认端口与服务地址由项目提供。
MINFO_BASE_URL=
MINFO_API_TOKEN=
PTGEN_BASE_URL=
PTGEN_API_TOKEN=
